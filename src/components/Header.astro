---
import { nav, site } from '../data/site';

const current = Astro.url.pathname.replace(/\/+$/, '') || '/';
const isActive = (href: string) => {
  const normalized = href.replace(/\/+$/, '') || '/';
  return current === normalized;
};
---

<header class="site-header" id="siteHeader">
  <div class="wrap header-bar">
    <a class="brand" href="/" aria-label="玥空玹 首页">
      <img src="/favicon.svg" alt="" width="26" height="26" />
      <span>{site.name}</span>
    </a>

    <div class="header-actions">
      <a
        class="icon-btn"
        href={site.github}
        target="_blank"
        rel="noopener"
        aria-label="GitHub 主页"
      >
        <svg viewBox="0 0 16 16" aria-hidden="true" fill="currentColor" stroke="none">
          <path
            d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82.64-.18 1.32-.27 2-.27.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8Z"
          ></path>
        </svg>
      </a>

      <button class="icon-btn" id="themeToggle" type="button" aria-label="切换深浅色主题">
        <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2"></circle>
          <path
            d="M12 2.6v2.2M12 19.2v2.2M2.6 12h2.2M19.2 12h2.2M5.4 5.4l1.6 1.6M17 17l1.6 1.6M18.6 5.4L17 7M7 17l-1.6 1.6"
          ></path>
        </svg>
        <svg class="icon-moon" viewBox="0 0 24 24" aria-hidden="true">
          <path d="M20.2 14.6A8.4 8.4 0 0 1 9.4 3.8a8.6 8.6 0 1 0 10.8 10.8z"></path>
        </svg>
      </button>
    </div>
  </div>
</header>

<nav class="site-nav" aria-label="主导航">
  <div class="wrap">
    {
      nav.map((item) => (
        <a href={item.href} aria-current={isActive(item.href) ? 'page' : undefined}>
          {item.label}
        </a>
      ))
    }
  </div>
</nav>
