---
import BaseLayout from '../layouts/BaseLayout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { site, projects, facts } from '../data/site';
---

<BaseLayout>
  <section class="wrap hero">
    <div class="hero-watermark" aria-hidden="true">玥</div>

    <p class="eyebrow reveal">
      <span class="dot" aria-hidden="true"></span>
      前端工程师 · 界面设计 · 开源
    </p>

    <h1 class="hero-title reveal">
      把想法<br />做成<span class="hl">能用的界面</span>
    </h1>

    <p class="hero-lead reveal">
      你好，我是<strong>{site.name}</strong>。我写前端，也琢磨排版、间距和动效——
      相信克制比堆叠更难，也更好看。
    </p>

    <p class="hero-actions reveal">
      <a class="btn btn-solid" href="/work/">
        看看作品
        <svg viewBox="0 0 16 16" aria-hidden="true">
          <path d="M3 8h9M8.5 3.5 13 8l-4.5 4.5"></path>
        </svg>
      </a>
      <a class="btn btn-ghost" href={`mailto:${site.email}`}>写封邮件</a>
    </p>

    <dl class="hero-facts reveal">
      {
        facts.map((fact) => (
          <div>
            <dt>{fact.label}</dt>
            <dd>
              {fact.live && <span class="live" aria-hidden="true" />}
              {fact.value}
            </dd>
          </div>
        ))
      }
    </dl>
  </section>

  <section class="wrap section" id="work">
    <div class="section-head reveal">
      <h2><span class="num">01</span> 精选作品</h2>
      <p class="section-note">三件占位项目，替换成你自己的即可。</p>
    </div>

    <div class="cards">
      {projects.map((project) => <ProjectCard project={project} />)}
    </div>
  </section>

  <section class="wrap section" id="about">
    <div class="section-head reveal">
      <h2><span class="num">02</span> 关于我</h2>
    </div>

    <div class="about-grid">
      <div class="reveal">
        <p class="about-lead">
          我做前端六年，喜欢把复杂的东西收拾干净：删掉不必要的边框，
          统一那 8 个相近的灰色，让一个按钮在 200ms 里刚好到位。
        </p>
        <p class="about-sub">
          工作之外写一点开源、拍一点照片、把喜欢的字体收藏到文件夹里再也不用。
          如果你在做一个需要“看起来就该长这样”的界面，我们大概聊得来。
          <a href="/about/">更多关于我 →</a>
        </p>
      </div>

      <div class="panel reveal">
        <p class="panel-title">技术栈</p>
        <ul class="skill-list">
          <li><span>语言</span><span>TypeScript · JavaScript · CSS</span></li>
          <li><span>框架</span><span>React · Vue · Astro</span></li>
          <li><span>样式</span><span>Tailwind · CSS Modules · PostCSS</span></li>
          <li><span>工程</span><span>Vite · pnpm · GitHub Actions</span></li>
          <li><span>设计</span><span>Figma · 设计 token · 无障碍</span></li>
        </ul>
      </div>
    </div>
  </section>

  <section class="wrap">
    <div class="cta reveal">
      <h2>有想法？<br />聊聊看。</h2>
      <p>不管是新项目、合作，还是只想讨论一下某个交互该怎么动，都欢迎。</p>
      <a class="mailto" href={`mailto:${site.email}`}>
        {site.email} ↗
      </a>
      <p class="links">
        <a href={site.github} rel="noopener">GitHub</a>
        <span aria-hidden="true">·</span>
        <a href={site.repo} rel="noopener">本站源码</a>
      </p>
    </div>
  </section>
</BaseLayout>
